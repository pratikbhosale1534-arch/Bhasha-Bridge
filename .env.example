# ── IBM watsonx.ai (Granite) ── placeholders only; NEVER commit a real .env ──
# IBM Cloud API key: IBM Cloud > Manage > Access (IAM) > API keys > Create
WATSONX_API_KEY=your-ibm-cloud-api-key
# watsonx.ai project ID: watsonx.ai > your project > Manage > General > Project ID
WATSONX_PROJECT_ID=your-watsonx-project-id
# Regional endpoint of YOUR watsonx.ai Runtime instance (must match the region you provisioned it in)
#   us-south: https://us-south.ml.cloud.ibm.com   eu-de: https://eu-de.ml.cloud.ibm.com
#   eu-gb:    https://eu-gb.ml.cloud.ibm.com      jp-tok: https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_API_VERSION=2024-05-31

# Force demo mode even if credentials exist (labelled placeholder output, no IBM calls)
# DEMO_MODE=true

# ── Limits & privacy ──
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=200
MAX_DOC_CHARS=60000
CHUNK_CHARS=2500
HISTORY_RETENTION_DAYS=7
RATE_LIMIT_PER_MIN=40
APP_DB=bhasha.db
